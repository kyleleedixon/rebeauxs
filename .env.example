# --- Google Sheets (server-side only; never prefix these with NEXT_PUBLIC_) ---
SHEET_ID=1ZWSCLyoDXbT8eXqLzgngf-mhnD4bVczerdWhRYkMuf8
GOOGLE_SERVICE_ACCOUNT_EMAIL=rbx-dashboard@your-project.iam.gserviceaccount.com
# Paste the whole private key on one line with literal \n where the newlines were,
# wrapped in double quotes. The app converts \n back into real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Site password (HTTP basic auth via middleware) ---
DASHBOARD_USER=rbx
DASHBOARD_PASSWORD=change-me

